{
  "tasks": [
    {
      "id": "AUTO-V2-SAMPLE-001",
      "title": "AUTODEV v2 safe sample dry-run",
      "mode": "dry-run",
      "description": "Demonstrate the AUTODEV v2 task schema without requesting ANKION product code changes.",
      "allowedFiles": [
        "tools/autodev/*"
      ],
      "forbiddenFiles": [
        "package.json",
        "pnpm-lock.yaml",
        ".env",
        ".env.*",
        "supabase/migrations/*",
        "apps/mobile/android/*",
        "android/*",
        "ios/*",
        "app.json",
        "eas.json",
        ".github/*",
        "**/build/*",
        "**/dist/*",
        "**/.expo/*",
        "**/node_modules/*"
      ],
      "validation": [
        "corepack pnpm --filter @ankion/mobile typecheck",
        "corepack pnpm --filter @ankion/web typecheck",
        "corepack pnpm --filter @ankion/web build"
      ],
      "riskLevel": "LOW",
      "requiresHumanApproval": true,
      "expectedOutcome": "A dry-run prompt and report only."
    }
  ]
}
