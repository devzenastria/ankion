# Dependencies
node_modules/
.pnpm-store/

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lockfiles from other package managers
package-lock.json
yarn.lock

# Build outputs
dist/
build/
.next/
out/
.expo/
.expo-shared/
web-build/

# Turbo
.turbo/

# TypeScript
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Supabase local/runtime files
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/.env.*

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Local cache
.cache/
.parcel-cache/

# Test / coverage outputs
coverage/
playwright-report/
test-results/

# Expo / React Native local outputs
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Keep documentation and scaffolds trackable
!docs/**
!apps/**/.gitkeep
!packages/**/.gitkeep
!supabase/**/.gitkeep
!dev/**/.gitkeep
!scripts/.gitkeep

# AUTODEV safety ignores
node_modules/
**/node_modules/
.expo/
**/.expo/
dist/
**/dist/
build/
**/build/
android/.gradle/
apps/mobile/android/.gradle/
*.log
.env
.env.*
**/.env
**/.env.*

# Local accidental command-output files
/cd
/corepack
/findstr

# Local backup/error artifacts
/backup-*
/gradle-clean-error.txt
/mobile-typecheck-error.txt
/docs_tree_report.txt

# Keep env example tracked, block real env files
!.env.example
# AUTODEV generated runtime artifacts
tools/autodev/reports/*.txt
tools/autodev/prompts/*.md
tools/autodev/state/*.json
tools/autodev/state/LATEST_HANDOFF.md
!tools/autodev/reports/.gitkeep
!tools/autodev/prompts/.gitkeep
!tools/autodev/state/.gitkeep

